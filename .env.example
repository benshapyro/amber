# Copy to .env.local for local development. On Vercel, set the same names
# in Project Settings > Environment Variables.

# Neon. The app connects as the restricted amber_app role (see README).
DATABASE_URL=postgres://amber_app:PASSWORD@HOST/neondb?sslmode=require
# Owner connection, used only for migrations and `pnpm db:app-role`.
DATABASE_URL_OWNER=postgres://neondb_owner:PASSWORD@HOST/neondb?sslmode=require

# Better Auth. Secret: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://amber.shapyro.com
# The only email that can ever sign in.
ALLOWED_EMAIL=ben@shapyro.com

# Resend, for magic-link emails. Leave empty locally: links print to the console.
RESEND_API_KEY=
EMAIL_FROM=Amber <amber@shapyro.com>

# Cloudflare R2 (S3 API token with Object Read & Write on the bucket).
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=amber-media

# Trigger.dev runs the processing job. "inline" runs it in the web process
# instead (local development only).
JOBS_MODE=trigger
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Mapbox reverse geocoding for place names. Optional: without it, places stay blank.
MAPBOX_TOKEN=
